{
  "name": "tagliandonline-backend",
  "private": true,
  "version": "0.0.1",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "build": "npx tsc",
    "run-build": "npm run db:push && node dist/index.js",
    "dev-watch": "npx tsx --watch src/index.ts",
    "dev-run": "npm run db:push && npx tsc --noEmit && npx tsx src/index.ts",
    "dev-run-test-conversion": "npx tsc --noEmit && npx tsx src/testing/testConversion.ts",
    "dev-run-test-report": "npx tsc --noEmit && npx tsx src/testing/testReportGeneration.ts",
    "db:push": "npx drizzle-kit push --force"
  },
  "keywords": [],
  "author": "Comune di Castagneto Carducci",
  "license": "AGPLv3",
  "description": "Backend TagliandOnline",
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "docx-templates": "^4.15.0",
    "dotenv": "^17.2.3",
    "drizzle-orm": "beta",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.0.2",
    "nodemailer": "^8.0.1",
    "pg": "^8.18.0",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@tsconfig/node24": "^24.0.4",
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.0.0",
    "@types/node": "^25.0.10",
    "@types/nodemailer": "^7.0.9",
    "@types/pg": "^8.16.0",
    "@types/qrcode": "^1.5.6",
    "drizzle-kit": "^1.0.0-beta.13-f728631",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}
