{
  "name": "tagliandonline-backend",
  "private": true,
  "version": "0.0.1",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "build": "npx tsc",
    "run-build": "node dist/index.js",
    "dev-watch": "npx tsx --watch src/index.ts",
    "dev-run": "npx tsc --noEmit && npx tsx src/index.ts",
    "dev-run-test-conversion": "npx tsc --noEmit && npx tsx src/testing/testConversion.ts",
    "dev-run-test-report": "npx tsc --noEmit && npx tsx src/testing/testReportGeneration.ts",
    "db:push": "npx drizzle-kit push"
  },
  "keywords": [],
  "author": "Comune di Castagneto Carducci",
  "license": "AGPLv3",
  "description": "Backend TagliandOnline",
  "dependencies": {
    "docx-templates": "^4.15.0",
    "dotenv": "^17.2.3",
    "drizzle-orm": "beta",
    "express": "^5.2.1",
    "pg": "^8.18.0",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@tsconfig/node24": "^24.0.4",
    "@types/express": "^5.0.6",
    "@types/node": "^25.0.10",
    "@types/pg": "^8.16.0",
    "@types/qrcode": "^1.5.6",
    "drizzle-kit": "^1.0.0-beta.13-f728631",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}
